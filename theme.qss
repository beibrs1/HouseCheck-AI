/*
 HouseCheck AI — стили стандартных виджетов. Цвета берутся из theme_tokens.py.
 Карточки, кнопки, кольца и навигация рисуются вручную в ui_kit.py.
*/

QWidget { color: @text@; }
QMainWindow, QDialog { background: @bg@; }
QLabel { background: transparent; border: none; }
QToolTip {
    background: @nav@; color: @nav_text@; border: none; border-radius: 8px;
    padding: 6px 10px; font-size: 12px;
}

QLineEdit, QPlainTextEdit, QTextEdit, QSpinBox, QDateEdit, QComboBox {
    background: @field@; color: @text@; border: 1.5px solid @border@;
    border-radius: 14px; padding: 9px 14px; selection-background-color: @accent@; font-size: 13px;
    selection-color: #FFFFFF;
}
QLineEdit:hover, QPlainTextEdit:hover, QSpinBox:hover, QDateEdit:hover, QComboBox:hover { border-color: @border_strong@; }
QLineEdit:focus, QPlainTextEdit:focus, QTextEdit:focus, QSpinBox:focus, QDateEdit:focus, QComboBox:focus { border-color: @accent@; }
QLineEdit:read-only { background: @surface_muted@; color: @text_muted@; }
QLineEdit#bare { border: none; background: transparent; padding: 0; font-size: 14px; }

QComboBox { padding-right: 30px; min-height: 20px; }
QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url("@assets@/chevron.svg"); width: 12px; height: 12px; margin-right: 14px; }
QComboBox QAbstractItemView {
    background: @surface@; color: @text@; border: 1px solid @border@; border-radius: 12px;
    padding: 6px; outline: none; selection-background-color: @accent_soft@; selection-color: @text@;
}
QComboBox QAbstractItemView::item { min-height: 30px; padding: 4px 10px; border-radius: 8px; }

QSpinBox::up-button, QSpinBox::down-button { width: 0; border: none; }

QScrollArea, QScrollArea > QWidget > QWidget { background: transparent; border: none; }
QScrollBar:vertical { background: transparent; width: 10px; margin: 4px 2px; }
QScrollBar::handle:vertical { background: @border_strong@; border-radius: 3px; min-height: 40px; }
QScrollBar::handle:vertical:hover { background: @accent@; }
QScrollBar:horizontal { background: transparent; height: 10px; margin: 2px 4px; }
QScrollBar::handle:horizontal { background: @border_strong@; border-radius: 3px; min-width: 40px; }
QScrollBar::add-line, QScrollBar::sub-line, QScrollBar::add-page, QScrollBar::sub-page { width: 0; height: 0; background: none; }

QTableWidget {
    background: @surface@; alternate-background-color: @surface_muted@; border: 1px solid @border@;
    border-radius: 20px; gridline-color: transparent; padding: 6px; outline: none;
    selection-background-color: @accent_soft@; selection-color: @text@;
}
QTableWidget::item { padding: 8px; border-bottom: 1px solid @grid@; }
QHeaderView { background: transparent; border: none; }
QTableCornerButton::section { background: transparent; border: none; }
QHeaderView::section {
    background: transparent; color: @text_muted@; border: none; border-bottom: 1px solid @border@;
    padding: 10px 8px; font-weight: 700; font-size: 11px; text-transform: uppercase;
}

QSlider::groove:horizontal { height: 8px; background: @grid@; border-radius: 4px; }
QSlider::sub-page:horizontal { background: qlineargradient(x1:0, y1:0, x2:1, y2:0, stop:0 @accent_glow@, stop:1 @accent@); border-radius: 4px; }
QSlider::handle:horizontal {
    background: #FFFFFF; border: 3px solid @accent@; width: 16px; height: 16px; margin: -7px 0; border-radius: 11px;
}
QSlider::handle:horizontal:hover { border-width: 5px; }

QCheckBox { spacing: 8px; }
QCheckBox::indicator { width: 20px; height: 20px; border-radius: 7px; border: 2px solid @border_strong@; background: @field@; }
QCheckBox::indicator:hover { border-color: @accent@; }
QCheckBox::indicator:checked { background: @accent@; border-color: @accent@; }

QMenu { background: @surface@; border: 1px solid @border@; border-radius: 12px; padding: 6px; }
QMenu::item { padding: 8px 18px; border-radius: 8px; color: @text@; }
QMenu::item:selected { background: @accent_soft@; }

QMessageBox { background: @surface@; }
QMessageBox QLabel { color: @text@; }
QDialogButtonBox QPushButton, QMessageBox QPushButton {
    background: @surface_muted@; color: @text@; border: 1px solid @border@; border-radius: 12px;
    padding: 8px 18px; min-width: 80px; font-weight: 600;
}
QDialogButtonBox QPushButton:hover, QMessageBox QPushButton:hover { border-color: @accent@; }
QDialogButtonBox QPushButton:default, QMessageBox QPushButton:default { background: @accent@; color: #FFFFFF; border-color: @accent@; }
QFormLayout QLabel { color: @text_muted@; }

QListWidget#palette { background: transparent; border: none; outline: none; }
QListWidget#palette::item { padding: 10px 12px; border-radius: 12px; color: @text@; margin: 1px 0; }
QListWidget#palette::item:selected, QListWidget#palette::item:hover { background: @accent_soft@; color: @text@; }
QPlainTextEdit#note { background: @surface_muted@; border: 1.5px solid @border@; border-radius: 16px; padding: 12px; font-size: 13px; }
QPlainTextEdit#note:focus { border-color: @accent@; }
QLineEdit#chatInput { border: none; background: transparent; padding: 0 6px; font-size: 14px; }

QDateEdit { padding-right: 34px; }
QDateEdit::drop-down { border: none; width: 30px; subcontrol-origin: padding; subcontrol-position: center right; }
QDateEdit::down-arrow { image: url("@assets@/chevron.svg"); width: 12px; height: 12px; }
QCalendarWidget QWidget { background: @surface@; color: @text@; }
QCalendarWidget QToolButton { color: @text@; background: transparent; font-weight: 700; padding: 4px 8px; }
QCalendarWidget QAbstractItemView:enabled { selection-background-color: @accent@; selection-color: #FFFFFF; }
